# Production default provider: MiniMax.
# Copy to .env on your computer/ECS and fill in the real key; never commit .env.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# ECS/Docker: this is already set by the Dockerfile. Keep the database on
# the mounted /app/data volume so redeploying the container does not erase data.
ZHIKE_DATABASE_PATH=/app/data/zhike.db
ZHIKE_ENV=production
# Generate a unique value on your ECS host: openssl rand -hex 32
# Never commit the real value to GitHub.
ZHIKE_SESSION_SECRET=replace_with_a_unique_64_character_secret
